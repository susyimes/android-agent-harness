<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:clipChildren="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_title"
                        android:textColor="@color/textPrimary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/settings_subtitle"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/settingsBackButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_back"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:translationZ="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_model_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settingsProviderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/configureProviderButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/settings_configure_model"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:translationZ="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_approval_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settingsApprovalStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/configureApprovalModeButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/settings_configure_approval"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:translationZ="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_accessibility_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settingsAccessibilityStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/openAccessibilityButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_open_accessibility_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:translationZ="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_house_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/settings_house_description"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/settingsHouseButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/settings_open_house"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:translationZ="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_data_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settingsDataStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/settingsControlCenterButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="打开完整 Agent 控制中心"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:translationZ="0dp" />

                <Button
                    android:id="@+id/clearSessionsButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/settings_clear_sessions"
                    android:textAllCaps="false"
                    android:textColor="@color/danger"
                    android:translationZ="0dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
