<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/textPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sessionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/session_subtitle"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/homeButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_home"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:translationZ="0dp" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/houseButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_house"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:translationZ="0dp" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/sessionButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_sessions"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:translationZ="0dp" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/newChatButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_new_chat"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:translationZ="0dp" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/settingsButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary_button"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_settings"
                    android:textAllCaps="false"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:translationZ="0dp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/providerSelector"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_surface_button"
            android:elevation="0dp"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/phoneUseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_use_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/phoneUseDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/phone_use_compact_note"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/phoneUseSettingsButton"
                android:layout_width="88dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_secondary_button"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:stateListAnimator="@null"
                android:text="@string/phone_use_permissions"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:translationZ="0dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/transcriptScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/transcriptContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_empty_state"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/emptyDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/empty_description"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/emptySetupButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_primary_button"
                    android:elevation="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_choose_provider"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/statusDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_dot"
                android:textColor="@color/success"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/statusView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_ready"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/toolDetailsButton"
                android:layout_width="70dp"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_secondary_button"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="工具(0)"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="10sp" />

            <Button
                android:id="@+id/speakButton"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_secondary_button"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="朗读"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/attachmentPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_surface_soft"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:textColor="@color/textSecondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="58dp"
            android:background="@drawable/bg_chat_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="7dp"
            android:paddingBottom="5dp">

            <Button
                android:id="@+id/attachmentButton"
                android:layout_width="38dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_secondary_button"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="＋"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="18sp" />

            <Button
                android:id="@+id/voiceButton"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_secondary_button"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="语音"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/inputField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/hint_message"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="46dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="72dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_primary_button"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_send"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
