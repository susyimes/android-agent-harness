<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/editorRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/editorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/editorSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/editorCancelButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_secondary_button"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/textPrimary"
                android:translationZ="0dp" />

            <Button
                android:id="@+id/editorSaveButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_primary_button"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:translationZ="0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/skillMetadataPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_surface_soft"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/skillNameInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_surface_card"
                android:hint="@string/house_skill_name_hint"
                android:inputType="textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary" />

            <EditText
                android:id="@+id/skillDescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_surface_card"
                android:hint="@string/house_skill_description_hint"
                android:inputType="textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary" />

            <Switch
                android:id="@+id/skillEnabledSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/house_skill_enabled"
                android:textColor="@color/textPrimary" />
        </LinearLayout>

        <EditText
            android:id="@+id/markdownInput"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_surface_card"
            android:gravity="start|top"
            android:hint="@string/house_markdown_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="14sp"
            android:typeface="monospace" />
    </LinearLayout>
</FrameLayout>
